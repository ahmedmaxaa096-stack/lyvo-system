# =============================================================
# LYVO Product Importer — الإعدادات الاختيارية
# انسخ هذا الملف إلى .env ثم عدّل القيم حسب الحاجة
# =============================================================

# منفذ الخادم
PORT=4176

# العملة الافتراضية إذا لم يستطع الموقع تحديدها (EGP / USD / SAR / AED ...)
DEFAULT_CURRENCY=EGP

# =============================================================
# بحث Google Programmable Search (اختياري — يحسّن نتائج البحث)
# 1) أنشئ محرك بحث على:  https://programmablesearchengine.google.com
#    وقيّده بنطاق موقع البراند (مثال: lyvo.com)
# 2) فعّل "Search entire web" أو أدخل مواقع البراند يدويًا
# 3) خذ CSE ID و API Key
# =============================================================
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# =============================================================
# مهلة طلبات جلب الصفحات بالمللي ثانية (ضع قيمة أعلى عند بطء الموقع)
# =============================================================
FETCH_TIMEOUT=40000